# ai-query-agent 环境变量（只放占位，真实值写在服务器 env 文件，权限 600，绝不入库）
# 不得出现任何 LARK_* / FEISHU_* 变量：存在即拒绝启动。

# ops 调用 agent 的共享密钥（至少 16 字符），与 ops 侧 AI_QUERY_AGENT_SECRET 相同
AGENT_SECRET=<changeme-random-32-chars>

# Claude 订阅 token（claude setup-token 生成）。调用 claude -p 不加 --bare
CLAUDE_CODE_OAUTH_TOKEN=<changeme>

# 只读库账号（stag：claude_bot_stag / petgo_stag；生产：claude_bot / petgo）
# 密码不放 env，写在 .pgpass（只读挂载到 PGPASSFILE）
PGHOST=petgo-postgres
PGPORT=5432
PGUSER=claude_bot_stag
PGDATABASE=petgo_stag
PGPASSFILE=/run/secrets/pgpass

# 以下有默认值，一般不改
# PORT=8790
# DATA_DIR=/data
# EXPORT_DIR=/exports
# WORK_DIR=/app/work
# JOB_TIMEOUT_MS=600000
# TZ=Asia/Jakarta

# 从 Bash 子进程剥离凭证，默认 1。依赖 bubblewrap 沙箱；当前服务器内核不允许容器内创建命名空间，
# 2026-11-10 Dai 确认置 0 并接受 Bash 可读订阅 token 的风险（spec §11）
# SUBPROCESS_ENV_SCRUB=0

# 白名单代理（Story 3.1 启用）
# HTTPS_PROXY=http://aiq-egress-proxy-stag:3128
# NO_PROXY=petgo-postgres
