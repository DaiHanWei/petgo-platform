<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>TailTopia</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>TailTopia</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>NSCameraUsageDescription</key>
		<string>TailTopia needs camera access so you can take photos of your pet for profiles, posts, and AI triage.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>TailTopia needs photo library access so you can choose pet photos for profiles, posts, and AI triage.</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>TailTopia needs permission to save your pet's ID card image to your photo library.</string>
		<!-- 定位（V1.3.0 batch-b1 Story 1.2 AC6）：场所列表按距离排序。
		     🔴 **本条文案按 AC6 要求用印尼语**（上面几条是英文，这里有意不同）：
		        它是给印尼终端用户看的授权弹窗正文，必须说清用途 = 按距离排序附近的宠物友好场所。
		     🛡 **只有 WhenInUse，没有 Always**：按距离排序只需要用户正在看列表的那一刻；
		        声明 Always 会在 App Store 审核里被要求解释一个我们并不存在的后台场景。 -->
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>TailTopia memakai lokasimu untuk mengurutkan tempat ramah hewan terdekat berdasarkan jarak.</string>
		<!-- Google 地图 iOS 密钥（V1.3.0 batch-b1 Story 1.4 · AD-3 Rule 4）。
		     🔴 这里**只有构建变量引用**，真实值来自 gitignored 的 ios/Flutter/Maps.xcconfig
		        （模板 Maps.xcconfig.example）—— 密钥绝不入库。
		     没配时解析成空串：地图是灰的，但包能编能装。AppDelegate 读这个键去初始化 SDK。 -->
		<key>GMSApiKey</key>
		<string>$(GOOGLE_MAPS_API_KEY)</string>
		<!-- ATT（iOS 14.5+，AppsFlyer 归因拿 IDFA 用）。⚠️ 提审前文案须与合规确认定稿并做
		     中/英/印尼三语本地化（InfoPlist.strings），与 App Store 隐私标签一致——交付文档 §3.5。 -->
		<key>NSUserTrackingUsageDescription</key>
		<string>We use this to show you more relevant content and offers for you and your pet.</string>
		<!-- Google Sign-In (google_sign_in 7.x)。client ID 非机密，随客户端分发。 -->
		<key>GIDClientID</key>
		<string>952015467016-rip06l8hh1mn4ppi4t3f758b0ah1nb8d.apps.googleusercontent.com</string>
		<!-- serverClientId：后端校验 idToken 的 aud（Web 类型客户端）。 -->
		<key>GIDServerClientID</key>
		<string>952015467016-3q9vb0ro18fnecl9gpnrddbfj9snqer0.apps.googleusercontent.com</string>
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<!-- iOS client ID 的 reversed 形式，供 Google OAuth 回跳。 -->
					<string>com.googleusercontent.apps.952015467016-rip06l8hh1mn4ppi4t3f758b0ah1nb8d</string>
				</array>
			</dict>
			<dict>
				<!-- 成长档案分享页深链：tailtopia://card/{token} → App 落成长档案（app_links 接收）。 -->
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLName</key>
				<string>id.tailtopia.card</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>tailtopia</string>
				</array>
			</dict>
		</array>
		<!-- 关闭 Flutter 引擎自动深链（bug 20260910-487）：与安卓清单 flutter_deeplinking_enabled=false 一致，
		     深链只走 app_links（deepLinkToLocation 转站内路径）。不关的话引擎会把原始 tailtopia://… 交给
		     go_router → 「Page Not Found / no routes for location」。 -->
		<key>FlutterDeepLinkingEnabled</key>
		<false/>
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<!-- 系统推送（TIMPush/APNs）：后台收远程通知（配 entitlements 的 aps-environment）。 -->
		<key>UIBackgroundModes</key>
		<array>
			<string>remote-notification</string>
		</array>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>
	</dict>
</plist>
