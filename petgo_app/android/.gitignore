# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks
# 例外：团队共享的 debug keystore（标准密码 android、非敏感，仅供开发/内部测试包，
# 使所有人编译 SHA-1 一致、Google 登录免逐机注册）。正式发布须另用 release keystore（勿入库）。
!app/debug.keystore

# Google 地图 Android 密钥（Story 1.4 · AD-3 Rule 4）：env 注入、绝不入库。
# 模板是 maps.properties.example（只放占位符，**是**入库的）。
maps.properties
